                }
              ],
              "body": "{\n  \"code\": 200,\n  \"success\": true,\n  \"message\": \"Current prices retrieved\",\n  \"data\": {\n    \"date\": \"2025-12-29\",\n    \"currency\": \"IDR\",\n    \"brands\": [\n      {\n        \"brand\": \"ANTAM\",\n        \"prices\": [\n          {\n            \"denominationGram\": 1,\n            \"sellPrice\": 2841000,\n            \"buybackPrice\": 2452000\n          }\n        ]\n      }\n    ]\n  }\n}"
            }
          ]
        }
      ]
    },
