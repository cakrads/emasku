generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // strongly recommended for time-series
}

////////////////////////////////////////
// ENUMS
////////////////////////////////////////

/// Explicit semantic meaning of a gold price.
/// These are NOT interchangeable.
enum PriceType {
  /// Market / reference price (charts, historical series)
  /// Example: Logam Mulia historical data
  SPOT

  /// Official listed retail price
  RETAIL

  /// Vendor selling price to customer
  SELL

  /// Vendor buyback price from customer
  BUYBACK
}

////////////////////////////////////////
// MODELS
////////////////////////////////////////

/// Immutable time-series price record.
/// One row == one market truth at one moment.
model GoldPrice {
  id String @id @default(cuid())

  ////////////////////////////////////////
  // CORE MARKET DATA
  ////////////////////////////////////////

  /// Stable identifier (e.g., "ANTAM", "GALERI24")
  brandCode String

  /// Display name of the brand
  brandName String

  /// Semantic type of this price
  priceType PriceType

  /// Gold weight in grams (exact value)
  /// Examples: 0.5, 1, 2.5, 10
  denominationGram Decimal @db.Decimal(10, 3)

  /// Price in smallest units (e.g., Satoshis, IDR Cents)
  /// BigInt supports large bars (1kg = 2.5B+ IDR)
  price BigInt

  /// ISO 4217 Currency Code
  /// Example: "IDR", "USD"
  currency String @default("IDR")

  ////////////////////////////////////////
  // TIME SEMANTICS
  ////////////////////////////////////////

  /// True market timestamp (UTC)
  /// Can be intraday
  /// Example: 2010-01-04T07:07:00Z
  priceAt DateTime

  /// When this record was ingested
  /// Observability only — NOT business identity
  recordedAt DateTime @default(now())

  ////////////////////////////////////////
  // TRACEABILITY & DEBUGGING
  ////////////////////////////////////////

  /// Source identifier (site, API, scraper name)
  source String?

  /// Original upstream payload for forensics
  rawPayload Json?

  createdAt DateTime @default(now())

  ////////////////////////////////////////
  // CONSTRAINTS & INDEXES
  ////////////////////////////////////////

  // One immutable market truth per:
  // brand + price type + denomination + timestamp
  @@unique([brandCode, priceType, denominationGram, priceAt])
  // Optimized for latest price lookups
  @@index([brandCode, priceType, denominationGram, priceAt(sort: Desc)])
  @@index([priceAt])
}

model User {
  id String @id @default(cuid())

  email String  @unique
  name  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  holdings PortfolioHolding[]
  consents Consent[]
}

enum ConsentPurpose {
  ACCOUNT_CREATION
  PORTFOLIO_ANALYTICS
  MARKETING
  THIRD_PARTY_SHARING
}

/// Audit trail of user consents for UU PDP compliance
model Consent {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  purpose   ConsentPurpose
  isGranted Boolean // true = Granted, false = Withdrawn

  version   String // Policy version agreed to, e.g. "v1.0"
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now()) // Timestamp of the action

  @@index([userId, purpose])
}

/**
 * User-owned gold holding.
 * Represents a historical purchase or position.
 */
model PortfolioHolding {
  id String @id @default(cuid())

  ////////////////////////////////////////
  // RELATIONS
  ////////////////////////////////////////

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Associated brand code (e.g., "ANTAM")
  /// This is a grouping category, not a related entity
  brandCode String

  /// Display name of the brand
  /// Useful for preserving user-typed custom brand names
  brandName String

  ////////////////////////////////////////
  // OWNERSHIP DATA
  ////////////////////////////////////////

  /**
   * Weight per unit in grams
   * Example: 1g bar
   */
  denominationGram Decimal @db.Decimal(10, 3)

  /**
   * Number of units owned
   */
  quantity Int

  /**
   * Buy price per unit (smallest currency unit)
   * Stored as BigInt for consistency with market prices
   */
  buyPrice BigInt

  /**
   * Purchase date
   */
  boughtAt DateTime

  /**
   * Sold date (if null, holding is ACTIVE)
   */
  soldAt DateTime?

  ////////////////////////////////////////
  // METADATA
  ////////////////////////////////////////

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ////////////////////////////////////////
  // INDEXES
  ////////////////////////////////////////

  @@index([userId])
  @@index([brandCode])
}
