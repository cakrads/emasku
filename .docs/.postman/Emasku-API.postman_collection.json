        {
          "name": "Get Spot Price Series",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/prices/spot?brand=ANTAM&from=2024-12-01T00:00:00Z&to=2024-12-31T23:59:59Z&denomination=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "prices",
                "spot"
              ],
              "query": [
                {
                  "key": "brand",
                  "value": "ANTAM",
                  "description": "Brand code (ANTAM, UBS, GALERI24, LOTUS_ARCHI)"
                },
                {
                  "key": "from",
                  "value": "2024-12-01T00:00:00Z",
                  "description": "Start date (ISO 8601 format)"
                },
                {
                  "key": "to",
                  "value": "2024-12-31T23:59:59Z",
                  "description": "End date (ISO 8601 format)"
                },
                {
                  "key": "denomination",
                  "value": "1",
                  "description": "Weight in grams (optional, defaults to 1)",
                  "disabled": false
                }
              ]
            },
            "description": "Get historical spot price time series for charting. All query parameters are required except denomination."
