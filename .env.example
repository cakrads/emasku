# Connect to Supabase via connection pooling
DATABASE_URL=

# Direct connection to the database. Used for migrations
DIRECT_URL=

# Scraper
SCRAPER_SOURCE=
SCRAPER_SECRET=

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# ============================================
# PUBLIC API SECURITY
# ============================================

# Public API Keys (optional for dev)
NEXT_PUBLIC_API_KEY_WEB=
NEXT_PUBLIC_API_KEY_MOBILE=

# --- API Key Enforcement (Optional) ---
# Set to 'true' to require x-public-key header in development
# (Always enforced in production)
# ENFORCE_PUBLIC_API_KEY=

# --- Rate Limiting (Upstash Redis) ---
# Get these from: https://console.upstash.com/redis
# Or use Vercel Storage → Create → Upstash Redis (auto-injects)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=